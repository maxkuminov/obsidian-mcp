# Database
DATABASE_URL=postgresql+asyncpg://obsidian_mcp:CHANGE_ME@postgres:5432/obsidian_mcp

# Vault
VAULT_PATH=/obsidian

# Security — itsdangerous signer for cookies/sessions. The app refuses to
# start while this is left at a known placeholder (CHANGE_ME, changeme, or
# empty), so you must replace it. Generate with `openssl rand -hex 32`.
SECRET_KEY=CHANGE_ME

# Multi-user mode — when true, the app enforces in-app username/password
# login, scopes data per user, and shows admin vs. regular UI in the panel.
# When false (default), the panel relies on Traefik OAuth and there is no
# in-app user concept. See README's "Multi-user mode" section for the
# full setup.
MULTI_USER_MODE=false

# Public hostname Traefik/Caddy routes to. Also auto-derives BASE_URL,
# ALLOWED_ORIGINS, and ALLOWED_HOSTS as `https://<MCP_HOSTNAME>` unless those
# are explicitly set below.
MCP_HOSTNAME=obsidian-mcp.example.com

# Optional explicit overrides (rarely needed). Useful behind a non-TLS proxy
# or when the OAuth issuer must differ from the hostname.
# BASE_URL=https://obsidian-mcp.example.com
# ALLOWED_ORIGINS=["https://obsidian-mcp.example.com"]
# ALLOWED_HOSTS=["obsidian-mcp.example.com","localhost"]

# Host port published by docker-compose.proxy.yml (external reverse proxy
# recipe). Only consumed by that compose file's port mapping, not the app.
# The mapping binds to loopback (127.0.0.1) by default — see DEPLOYMENT.md.
# MCP_PORT=8000

# Indexer
INDEX_INTERVAL_SECONDS=300

# Raw file-access tools (read_file / write_file). Size caps in BYTES, and they
# bound what the SERVER moves to and from disk: the read cap (default 10 MB)
# refuses an oversized file outright, the write cap (default 25 MB) is the
# decoded byte ceiling for an upload.
# MAX_FILE_READ_BYTES=10485760
# MAX_FILE_WRITE_BYTES=26214400

# Cap in CHARACTERS on what a single read_note / read_file call RETURNS to the
# caller (default 40,000, roughly 10K tokens). This is a different limit from
# the byte caps above and does a different job: those stop the server reading a
# huge file into memory, this stops a legitimately-read file from exhausting the
# model's context window. A 3 MB note passes MAX_FILE_READ_BYTES easily and
# would still wreck a context window.
#
# It bounds each COMPONENT of a response, not the response as a whole: the
# content window gets this budget, and the heading outline gets it separately.
# A truncated read can carry both, so size for ~2x this value plus a few
# hundred characters of fixed notice text.
#
# Over-cap reads return the first window, the offset to continue from, and an
# outline of the note's sections so a caller can fetch just the one it needs.
# Raise this only if your clients genuinely want larger single reads.
# MAX_READ_RESPONSE_CHARS=40000

# Full-text (keyword) search configuration(s). PostgreSQL text-search config
# names, applied at both index and query time. JSON list or comma-separated.
#   english             default — English Snowball stemmer (current behavior)
#   simple              language-agnostic, exact word forms, no stemming
#   english,norwegian   both stemmers — good for a mixed-language vault
#   simple,norwegian    verbatim lexemes PLUS Norwegian stems
# A note is indexed under every listed config and a query matches if ANY
# config's parse hits. Changing this makes stored tsvectors stale — after
# editing, redeploy and run `make rebuild-tsvectors` (keyword index only;
# does NOT touch embeddings and makes NO API calls — unlike reset-embeddings).
# FTS_CONFIGS=english

# Chunk size in tokens (~4 chars/token heuristic). 512 matches bge-m3's
# design point. Changing post-deploy requires `make reset-embeddings`.
CHUNK_SIZE=512
# Overlap disabled per 2025 benchmarks; raise only if you have evidence
# it helps your corpus. Changing post-deploy requires `make reset-embeddings`.
CHUNK_OVERLAP=0

# Path globs (fnmatch) skipped by the embedder. Excluded files stay
# keyword-searchable but produce no vectors. JSON-array form.
# EMBEDDING_EXCLUDE_PATTERNS=["*.excalidraw.md","Excalidraw/*"]

# Embedding provider — `ollama` (default, self-hosted) or `openai` (BYO key).
# Switching providers post-deploy requires `make reset-embeddings`.
EMBEDDING_PROVIDER=ollama

# Vector dimension. Default 1024 matches Ollama+bge-m3 and is also a good
# fit for OpenAI's `text-embedding-3-*` (which honor the `dimensions` param).
EMBEDDING_DIMENSIONS=1024

# --- Ollama settings (used when EMBEDDING_PROVIDER=ollama) ---
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
# How long Ollama keeps the model in VRAM after an embed call. "-1" pins it
# indefinitely (avoids a ~15s cold reload when semantic_search is used
# infrequently and the model gets evicted); a Go duration like "30m" frees
# VRAM when idle. Pin only if the model comfortably fits alongside others.
OLLAMA_KEEP_ALIVE=-1

# --- OpenAI settings (used when EMBEDDING_PROVIDER=openai) ---
# Required when provider=openai; server refuses to start otherwise.
OPENAI_API_KEY=
# Base URL — point at Azure OpenAI or OpenAI-compatible proxies if desired.
OPENAI_BASE_URL=https://api.openai.com/v1
# `text-embedding-3-small` is cheapest; `-large` has ~3x quality at higher cost.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Glama registry sandbox mode (do NOT enable in production) ---
# When true, the server starts without Postgres, the embedding provider,
# or the vault, and the /mcp auth middleware is bypassed. Tools register
# but cannot run. This exists solely so Glama's registry sandbox can
# build the image and validate MCP tool definitions.
# MCP_SANDBOX_MODE=false
