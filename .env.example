# Database
DATABASE_URL=postgresql+asyncpg://obsidian_mcp:CHANGE_ME@postgres:5432/obsidian_mcp

# Vault
VAULT_PATH=/obsidian

# Security — itsdangerous signer for cookies/sessions. The app refuses to
# start while this is left at a known placeholder (CHANGE_ME, changeme, or
# empty), so you must replace it. Generate with `openssl rand -hex 32`.
SECRET_KEY=CHANGE_ME

# Multi-user mode — when true, the app enforces in-app username/password
# login, scopes data per user, and shows admin vs. regular UI in the panel.
# When false (default), the panel relies on Traefik OAuth and there is no
# in-app user concept. See README's "Multi-user mode" section for the
# full setup.
MULTI_USER_MODE=false

# Panel session cookie: lifetime in seconds (default 7 days) and cookie name.
# Only used when MULTI_USER_MODE=true; single-user panels have no login.
# SESSION_MAX_AGE=604800
# SESSION_COOKIE_NAME=omcp_session

# Public hostname Traefik/Caddy routes to. Also auto-derives BASE_URL,
# ALLOWED_ORIGINS, and ALLOWED_HOSTS as `https://<MCP_HOSTNAME>` unless those
# are explicitly set below.
MCP_HOSTNAME=obsidian-mcp.example.com

# Optional explicit overrides (rarely needed). Useful behind a non-TLS proxy
# or when the OAuth issuer must differ from the hostname.
# BASE_URL=https://obsidian-mcp.example.com
# ALLOWED_ORIGINS=["https://obsidian-mcp.example.com"]
# ALLOWED_HOSTS=["obsidian-mcp.example.com","localhost"]

# Host port published by docker-compose.proxy.yml (external reverse proxy
# recipe). Only consumed by that compose file's port mapping, not the app.
# The mapping binds to loopback (127.0.0.1) by default — see DEPLOYMENT.md.
# MCP_PORT=8000

# Indexer
INDEX_INTERVAL_SECONDS=300

# Raw file-access tools (read_file / write_file). Size caps in BYTES, and they
# bound what the SERVER moves to and from disk: the read cap (default 10 MB)
# refuses an oversized file outright, the write cap (default 25 MB) is the
# decoded byte ceiling for an upload.
# MAX_FILE_READ_BYTES=10485760
# MAX_FILE_WRITE_BYTES=26214400

# File transfer (`request_upload` / `request_download` / `import_from_url` and
# the public `/transfer/*` routes). MCP_HOSTNAME (or BASE_URL) must be set or
# the mint tools refuse rather than hand out a localhost link.
#
# Default lifetime of a minted link, in seconds. A per-call `expires_in` is
# clamped to 60-3600 and so is this default. A link can never outlive the
# credential that minted it, so the effective deadline may be shorter.
# TRANSFER_TOKEN_TTL_SECONDS=600
# How long one claimed upload may keep streaming before the token is spent.
# TRANSFER_MAX_UPLOAD_SECONDS=600
# Simultaneous streaming uploads accepted by PUT /transfer/upload.
# TRANSFER_MAX_CONCURRENT_UPLOADS=4
# Let `import_from_url` fetch plain http (and ports 80/8080). Off by default;
# the outbound deny policy for private/loopback/metadata addresses still applies.
# IMPORT_ALLOW_HTTP=false

# Named-staging fallback (one flag, both write paths — notes and transfers).
# Writes normally stage into an unnamed O_TMPFILE inode so no temporary name
# ever exists in the vault. Some servers refuse O_TMPFILE outright (TrueNAS
# SCALE's NFS export answers EOPNOTSUPP, for example); there, no-clobber note
# writes and every transfer publication refuse with an error naming this flag.
# Setting it takes named staging back on BOTH paths — a weaker, declared
# guarantee, not a fix. When a call actually stages under a name the server
# logs one WARNING and /health reports
# `vault_named_staging_fallback_active: true`.
# VAULT_ALLOW_NAMED_STAGING_FALLBACK=false

# Cap in CHARACTERS on what a single read_note / read_file call RETURNS to the
# caller (default 40,000, roughly 10K tokens). This is a different limit from
# the byte caps above and does a different job: those stop the server reading a
# huge file into memory, this stops a legitimately-read file from exhausting the
# model's context window. A 3 MB note passes MAX_FILE_READ_BYTES easily and
# would still wreck a context window.
#
# It bounds each COMPONENT of a response, not the response as a whole: the
# content window gets this budget, and the heading outline gets it separately.
# A truncated read can carry both, so size for ~2x this value plus a few
# hundred characters of fixed notice text.
#
# Over-cap reads return the first window, the offset to continue from, and an
# outline of the note's sections so a caller can fetch just the one it needs.
# Raise this only if your clients genuinely want larger single reads.
# MAX_READ_RESPONSE_CHARS=40000

# Full-text (keyword) search configuration(s). PostgreSQL text-search config
# names, applied at both index and query time. JSON list or comma-separated.
#   english             default — English Snowball stemmer (current behavior)
#   simple              language-agnostic, exact word forms, no stemming
#   english,norwegian   both stemmers — good for a mixed-language vault
#   simple,norwegian    verbatim lexemes PLUS Norwegian stems
# A note is indexed under every listed config and a query matches if ANY
# config's parse hits. Changing this makes stored tsvectors stale — after
# editing, redeploy and run `make rebuild-tsvectors` (keyword index only;
# does NOT touch embeddings and makes NO API calls — unlike reset-embeddings).
# FTS_CONFIGS=english

# Chunk size in tokens (~4 chars/token heuristic). 512 matches bge-m3's
# design point. Changing post-deploy requires `make reset-embeddings`.
CHUNK_SIZE=512
# Overlap disabled per 2025 benchmarks; raise only if you have evidence
# it helps your corpus. Changing post-deploy requires `make reset-embeddings`.
# Must stay strictly BELOW CHUNK_SIZE — the chunker steps forward by
# (size - overlap), so an equal value steps one character at a time and 3 KB of
# prose becomes thousands of near-identical chunks. The server refuses to start
# on an overlap greater than or equal to the size.
CHUNK_OVERLAP=0

# Path globs (fnmatch) skipped by the embedder. Excluded files stay
# keyword-searchable but produce no vectors. JSON-array form.
# EMBEDDING_EXCLUDE_PATTERNS=["*.excalidraw.md","Excalidraw/*"]

# Embedding provider — `ollama` (default, self-hosted) or `openai` (BYO key).
# Switching providers post-deploy requires `make reset-embeddings`.
EMBEDDING_PROVIDER=ollama

# Vector dimension. Default 1024 matches Ollama+bge-m3 and is also a good
# fit for OpenAI's `text-embedding-3-*` (which honor the `dimensions` param).
EMBEDDING_DIMENSIONS=1024

# --- Ollama settings (used when EMBEDDING_PROVIDER=ollama) ---
OLLAMA_URL=http://ollama:11434
# The Ollama embedding model. Changing post-deploy requires
# `make reset-embeddings`: a different model produces vectors in a different
# space, and cosine distance between two spaces is meaningless. The server
# refuses to start when this differs from the configuration the stored vectors
# were built under — including a same-dimension swap, which the dimension guard
# cannot see.
# The model ARTIFACT can also change under an unchanged name: `bge-m3` is a
# mutable tag, so `ollama pull` can replace the weights behind it, and pointing
# OLLAMA_URL at another host can serve different weights under the same name.
# Both require `make reset-embeddings` too, and NO startup check will catch
# either — the stored fingerprint records the configuration, not the artifact.
EMBEDDING_MODEL=bge-m3
# How long Ollama keeps the model in VRAM after an embed call. "-1" pins it
# indefinitely (avoids a ~15s cold reload when semantic_search is used
# infrequently and the model gets evicted); a Go duration like "30m" frees
# VRAM when idle. Pin only if the model comfortably fits alongside others.
OLLAMA_KEEP_ALIVE=-1

# --- OpenAI settings (used when EMBEDDING_PROVIDER=openai) ---
# Required when provider=openai; server refuses to start otherwise.
OPENAI_API_KEY=
# Base URL — point at Azure OpenAI or OpenAI-compatible proxies if desired.
OPENAI_BASE_URL=https://api.openai.com/v1
# `text-embedding-3-small` is cheapest; `-large` has ~3x quality at higher cost.
# Changing post-deploy requires `make reset-embeddings`, exactly as switching
# providers does; the server refuses to start when this differs from the
# configuration the stored vectors were built under. And as with EMBEDDING_MODEL,
# a model artifact replaced behind an unchanged name — a repointed
# OPENAI_BASE_URL, or a proxy serving different weights — requires the reset and
# is detected by NO startup check.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- /mcp rate limits (see docs/architecture/rate-limits.md) ---
#
# All of this is IN-PROCESS state and is deliberately not persisted, which is
# sound only because the server runs `--workers 1`. A second worker gives each
# worker a full set of buckets, multiplying every rate below by the worker
# count.
#
# **How to turn one off.** Every nullable setting here accepts exactly one
# documented spelling of "off": an empty value, or the literal `null` or `none`
# (stripped, case-insensitive). Null is the ONLY disable — zero is rejected at
# startup for all of them, because a control that refuses every call reads as
# an outage rather than as a setting. A bucket's rate and burst must be set
# together or nulled together; half-configuring one refuses the boot.

# Failed `/mcp` authentications one client address may make per window before
# it is refused with HTTP 429 + Retry-After. Checked BEFORE the credential
# lookup, so a refused probe costs no database session and no query. It bounds
# the database work an unauthenticated caller can force; it is not a defence
# against credential guessing. Generous on purpose — claude.ai egresses from
# shared addresses and no working client fails 60 times in five minutes.
# MCP_AUTH_FAILURE_LIMIT=60
# MCP_AUTH_FAILURE_WINDOW_SECONDS=300
# Counter slots in the fixed-size, per-process-salted address table. Memory is
# O(size) with nothing to evict; collisions merge two addresses into one budget,
# which only ever makes the control stricter.
# MCP_AUTH_FAILURE_TABLE_SIZE=4096

# The general velocity bucket: sustained tool calls per minute per principal
# (an API key, or an OAuth *grant*), with the burst as its capacity. Far above
# observed usage; it stops a hot loop within a second, and the burst covers a
# post-search fan-out.
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_RATE_LIMIT_BURST=30

# The write bucket, which the eight vault-mutating tools must pass IN ADDITION
# to the general one — and which `PUT /transfer/upload` also consumes, charged
# to the principal that minted the capability. A VELOCITY bound, not a
# blast-radius one: neither bucket limits the total work a credential can do in
# a day. Only the daily quota does that, and only for the keys it reaches.
# MCP_WRITE_RATE_LIMIT_PER_MINUTE=60
# MCP_WRITE_RATE_LIMIT_BURST=15

# Principals holding their own limiter entry before further ones fold onto a
# single shared overflow entry. Reaching it needs more than ten thousand live
# credentials.
# MCP_LIMITER_MAX_TRACKED_PRINCIPALS=10000

# How long one (principal, tool, marker, scope) coalescing window stays open.
# Inside it a rate refusal issues NO statement of any kind, and the row that is
# eventually written stands for `1 + suppressed` refusals. A rate refusal
# arrives at the caller's own arrival rate — the very rate nothing else bounds
# — so uncoalesced refusal rows would be the amplification this exists to stop.
# MCP_REFUSAL_LOG_INTERVAL_SECONDS=10

# The daily quota a NEWLY CREATED API key receives when the caller does not say
# otherwise. Applied by the key-creation paths and never as a column default:
# keys that already exist are untouched, and an explicit null on the JSON API
# (or a blank field in the panel create form) still means unlimited. Null here
# means new keys are created unlimited, as they were before.
# DEFAULT_DAILY_REQUEST_LIMIT=5000

# --- Glama registry sandbox mode (do NOT enable in production) ---
# When true, the server starts without Postgres, the embedding provider,
# or the vault, and the /mcp auth middleware is bypassed. Tools register
# but cannot run. This exists solely so Glama's registry sandbox can
# build the image and validate MCP tool definitions.
# MCP_SANDBOX_MODE=false
