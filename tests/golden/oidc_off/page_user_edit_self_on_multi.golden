            </a>
            
        </nav>

        <div class="sidebar-foot">
            <button type="button" class="theme-toggle" data-theme-toggle
        aria-label="Switch to light theme" title="Switch to light theme">
    <svg class="icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <circle cx="8" cy="8" r="3.1"/>
        <path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.05 3.05l1.27 1.27M11.68 11.68l1.27 1.27M3.05 12.95l1.27-1.27M11.68 4.32l1.27-1.27"/>
    </svg>
    <svg class="icon-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M13.5 9.6A5.9 5.9 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z"/>
    </svg>
</button>
        </div>
    </aside>

    <!-- ── Main ── -->
    <div class="main">
        
        <div class="base-user-bar">
            <span class="user-badge">
                <span class="user-badge-name">admin</span>
                <span class="user-badge-role">Admin</span>
            </span>
            <form method="POST" action="/admin/auth/logout" class="u-margin-0">
                <input type="hidden" name="csrf_token" value="<CSRF>">
                <button type="submit" class="logout-btn" title="Sign out">Logout</button>
            </form>
        </div>
        
        

<div class="page-top">
    <h1 class="page-title">Edit user: <span class="u-color-primary-text">admin</span></h1>
    <div class="page-actions">
        <a href="/admin/users/" class="btn btn-ghost">← Back to users</a>
    </div>
</div>

<div class="page-body">

    
    

    <div class="split-2">

        <!-- Profile / role / vault -->
        <div class="card anim-1">
            <div class="card-header">
                <span class="card-title">Profile</span>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/users/<UID:admin>/edit">
                    <input type="hidden" name="csrf_token" value="<CSRF>">
                    <div class="field">
                        <label class="field-label">Vault Path</label>
                        <select name="vault_path" class="field-select" id="vault-select">
                            <option value="">(unassigned — every MCP tool refuses; index kept for reassignment)</option>
                            
                            <option value="<VAULT>" selected><VAULT></option>
                            
                            <option value="__custom__" >Custom path…</option>
                        </select>
                        <input type="text" name="vault_path_custom" id="vault-custom"
                               class="field-input ue-vault-custom"
                               placeholder="/vaults/<name>"
                               value="">
                        <div class="u-font-size-11px u-color-text-3 u-margin-top-6px">
                            Must be a subpath of <code class="mono">/vaults/</code> or the legacy mount.
                            Directory must exist in the container.
                        </div>
                    </div>
                    <div class="field u-display-flex u-align-items-center u-gap-10px">
                        <input type="checkbox" name="is_admin" id="is_admin" checked
                               disabled
                               class="u-width-18px u-height-18px u-accent-color-primary">
                        <label for="is_admin" class="u-font-size-14px u-color-text u-cursor-pointer">
                            Admin
                            <span class="ue-check-hint">
                                Sees all users' control-plane data; can manage users + settings.
                            </span>
                        </label>
                    </div>
                    <div class="field u-display-flex u-align-items-center u-gap-10px">
                        <input type="checkbox" name="is_active" id="is_active" checked
                               disabled
                               class="u-width-18px u-height-18px u-accent-color-primary">
                        <label for="is_active" class="u-font-size-14px u-color-text u-cursor-pointer">
                            Active
                            <span class="ue-check-hint">
                                Inactive users cannot log in and are skipped by the indexer.
                            </span>
                        </label>
                    </div>
                    
                    <div class="alert alert-warning u-margin-top-8px u-font-size-12px">
                        This is your own account — you can't remove your own admin role or
                        deactivate yourself here. Both toggles are locked, and the server
                        refuses the change even if the form is bypassed. Another admin can
                        do it from this page.
                    </div>
                    
                    <div class="u-display-flex u-gap-10px u-margin-top-18px">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Reset password -->
        <div class="card anim-2">
            <div class="card-header">
                <span class="card-title">Reset password</span>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/users/<UID:admin>/reset-password">
                    <input type="hidden" name="csrf_token" value="<CSRF>">
                    <div class="field">
                        <label class="field-label">New password</label>
                        
                        <input type="password" name="new_password" required minlength="12"
                               class="field-input" placeholder="≥ 12 characters" autocomplete="new-password">
                        <div class="u-font-size-11px u-color-text-3 u-margin-top-6px">
                            Replaces the user's current password. Communicate the new one
                            to them out-of-band.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Reset password</button>
                </form>
            </div>
        </div>

    </div>

    <!-- Single sign-on (#416). The subject is shown truncated, the issuer never.
         Expect and bind are offered only on an unlinked or pending row: a
         bound user is never re-pointed without an explicit unlink. -->
    <div class="card anim-3 u-margin-top-20px">
        <div class="card-header">
            <span class="card-title">Single sign-on</span>
        </div>
        <div class="card-body">
            <div class="kv">
                <div class="kv-k">Status</div>
                <div class="kv-v">
                    
                    Linked (since <time datetime="<DATETIME>" data-localize="date"><DATETIME></time>)
                    <span class="mono u-color-text-3">immutabl…</span>
                    
                </div>
            </div>
            
            
            <div class="kv u-margin-top-12px">
                <div>
                    <div class="kv-k">Unlink</div>
                    <div class="u-color-text-3 u-font-size-12px u-margin-top-4px">
                        Clears the link or the pending address and signs this user out
                        of every browser.
                        
                    </div>
                </div>
                <form method="POST" action="/admin/users/<UID:admin>/oidc/unlink">
                    <input type="hidden" name="csrf_token" value="<CSRF>">
                    <button type="button" class="btn btn-danger"
                            
                            data-confirm="Unlink this user from single sign-on? Their live sessions end.">
                        Unlink
                    </button>
                </form>
            </div>
            
        </div>
    </div>

    <!-- Danger zone -->
    <div class="card anim-3 u-margin-top-20px u-border-color-error-border">
        <div class="card-header">
            <span class="card-title u-color-error">Danger zone</span>
        </div>
        <div class="card-body">
            
            <div class="alert alert-warning u-margin-bottom-14px u-font-size-12px">
                This is your own account — you can't deactivate or permanently
                delete it here. Both controls are locked, and the server refuses
                the request even if the form is bypassed. The permanent form is
                the worse of the two: the cascade on <code class="mono">users.id</code>
                would take your own api_keys / oauth_clients / oauth_tokens /
                notes_metadata with it, leaving nothing to sign back in with and
                undo it. Another admin can do it from this page.
            </div>
            
            <div class="kv">
                <div>
                    <div class="kv-k">Deactivate user</div>
                    <div class="u-color-text-3 u-font-size-12px u-margin-top-4px">
                        Soft-delete: sets <code class="mono">is_active=false</code>. Data preserved;
                        the user can no longer log in. Reversible by re-saving the form above.
                    </div>
                </div>
                
                <form method="POST" action="/admin/users/<UID:admin>/delete">
                    <input type="hidden" name="csrf_token" value="<CSRF>">
                    <button type="button" class="btn btn-danger"
                            disabled
                            data-confirm="Deactivate this user? They will no longer be able to log in.">
                        Deactivate
                    </button>
                </form>
            </div>
            <div class="kv">
                <div>
                    <div class="kv-k u-color-error">Permanent delete</div>
                    <div class="u-color-text-3 u-font-size-12px u-margin-top-4px">
                        Cascades: removes the user row plus all their api_keys / oauth_clients /
                        oauth_tokens / notes_metadata via FK. Usage logs persist with
                        <code class="mono">user_id=NULL</code>. <strong>Irreversible.</strong>
                    </div>
                </div>
                <form method="POST" action="/admin/users/<UID:admin>/delete?permanent=true">
                    <input type="hidden" name="csrf_token" value="<CSRF>">
                    <button type="button" class="btn btn-danger"
                            disabled
                            data-confirm="PERMANENTLY DELETE this user and all their data? This cannot be undone.">
                        Permanently delete
                    </button>
                </form>
            </div>
            <div class="kv">
                <div>
                    <div class="kv-k">Confirm vault is empty</div>
                    <div class="u-color-text-3 u-font-size-12px u-margin-top-4px">
                        The indexer will not delete this user's index when
                        their vault root contains no markdown files — usually
                        a mount that did not mount. If the vault really was
                        emptied, confirm it: the next pass for this user only
                        may then delete every indexed note. The next page
                        shows how many and asks again (#309).
                    </div>
                </div>
                <a href="/admin/users/<UID:admin>/confirm-empty-vault" class="btn btn-danger">
                    Confirm vault is empty
                </a>
            </div>
        </div>
    </div>

</div>

<script nonce="<NONCE>">
// Toggle custom-path input visibility based on dropdown selection.
(function() {
    const sel = document.getElementById('vault-select');
    const custom = document.getElementById('vault-custom');
    function update() {
        if (sel.value === '__custom__') {
            custom.style.display = 'block';
            custom.required = true;
            custom.name = 'vault_path';
            sel.removeAttribute('name');
        } else {
            custom.style.display = 'none';
            custom.required = false;
            custom.removeAttribute('name');
            sel.name = 'vault_path';
        }
    }
    sel.addEventListener('change', update);
    update();
})();
</script>


    </div>

</div>

<script nonce="<NONCE>">
// Close sidebar when a nav link is tapped on mobile
document.querySelectorAll('.sidebar .nav-item').forEach(function(a) {
    a.addEventListener('click', function() {
        document.querySelector('.sidebar').classList.remove('open');
        document.querySelector('.sidebar-backdrop').classList.remove('open');
    });
});

// Localize ISO-8601 UTC timestamps to the viewer's locale.
(function() {
    const fmtDateTime = new Intl.DateTimeFormat(undefined, {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false,
    });
    const fmtDate = new Intl.DateTimeFormat(undefined, {
        year: 'numeric', month: '2-digit', day: '2-digit',
    });
    document.querySelectorAll('time[data-localize]').forEach(function(el) {
        const iso = el.getAttribute('datetime');
        if (!iso) return;
        const d = new Date(iso);
        if (isNaN(d)) return;
        el.textContent = el.dataset.localize === 'date' ? fmtDate.format(d) : fmtDateTime.format(d);
    });
})();
</script>

</body>
</html>