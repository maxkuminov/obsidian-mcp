            <svg class="brand-icon" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="15,2 27,10 24,25 6,25 3,10" fill="none" stroke-width="1.4" class="gem-edge"/>
                <polygon points="15,2 27,10 15,8"          class="gem-facet"/>
                <polygon points="15,8 27,10 24,25 6,25 3,10" class="gem-facet-2"/>
                <line x1="15" y1="2"  x2="15" y2="8"  stroke-width="0.8" opacity="0.7" class="gem-edge"/>
                <line x1="15" y1="8"  x2="3"  y2="10" stroke-width="0.5" opacity="0.4" class="gem-edge"/>
                <line x1="15" y1="8"  x2="27" y2="10" stroke-width="0.5" opacity="0.4" class="gem-edge"/>
                <line x1="15" y1="8"  x2="6"  y2="25" stroke-width="0.4" opacity="0.3" class="gem-edge"/>
                <line x1="15" y1="8"  x2="24" y2="25" stroke-width="0.4" opacity="0.3" class="gem-edge"/>
            </svg>
            <span class="brand-name">Obsidian</span>
            <span class="brand-tagline">MCP Control</span>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">System</div>
            <a href="/admin/" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <rect x="1.5" y="1.5" width="5" height="5" rx="1.2"/><rect x="9.5" y="1.5" width="5" height="5" rx="1.2"/>
                    <rect x="1.5" y="9.5" width="5" height="5" rx="1.2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1.2"/>
                </svg>
                Dashboard
            </a>
            <a href="/admin/usage" class="nav-item ">
