                    <line x1="1.8" y1="6" x2="14.2" y2="6"/>
                    <line x1="1.8" y1="10" x2="14.2" y2="10"/>
                </svg>
                OAuth
            </a>
            
            
            <a href="/admin/account" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="5.5" r="2.8"/>
                    <path d="M2.5 14c0-2.8 2.4-4.8 5.5-4.8s5.5 2 5.5 4.8"/>
                </svg>
                Account
            </a>
            

            <div class="nav-section">Content</div>
            <a href="/admin/vault" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1.5 4 Q1.5 2 3.5 2 L6.5 2 L8 3.5 L13.5 3.5 Q14.5 3.5 14.5 4.5 L14.5 13 Q14.5 14 13.5 14 L2.5 14 Q1.5 14 1.5 13Z"/>
