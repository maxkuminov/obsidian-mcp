                    <circle cx="7" cy="7" r="4.5"/>
                    <line x1="10.4" y1="10.4" x2="14.5" y2="14.5"/>
                </svg>
                Search
            </a>
            <a href="/admin/health" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1.5,8.5 4.5,8.5 6,5 8.5,11.5 10.5,8.5 14.5,8.5"/>
                </svg>
                Health
            </a>

            <div class="nav-section">Access</div>
            <a href="/admin/keys" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <circle cx="6" cy="7.5" r="3.2"/>
                    <line x1="8.5" y1="9.5" x2="15" y2="9.5"/>
                    <line x1="12" y1="9.5" x2="12" y2="12"/>
                    <line x1="14.5" y1="9.5" x2="14.5" y2="11.5"/>
                </svg>
                API Keys
            </a>
            <a href="/admin/oauth" class="nav-item ">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <circle cx="8" cy="8" r="6.2"/>
