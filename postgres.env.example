# PostgreSQL bootstrap SUPERUSER password for the bundled compose stacks
# (docker-compose.simple.yml / docker-compose.proxy.yml).
#
# Copy to `postgres.env` (gitignored) next to the compose file and keep it
# owner-only:
#
#   cp postgres.env.example postgres.env && chmod 600 postgres.env
#
# Only the postgres service loads this file. The application never sees it:
# the app connects as the non-superuser role `obsidian_mcp` with
# OBSIDIAN_DB_PASSWORD from `.env`. Do NOT put POSTGRES_PASSWORD in `.env`.
#
# At least 24 characters, not a placeholder, and different from
# OBSIDIAN_DB_PASSWORD; the postgres container refuses to start otherwise.
# Generate one with:  openssl rand -hex 32
POSTGRES_PASSWORD=
